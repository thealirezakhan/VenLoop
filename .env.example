# Set NEXT_PUBLIC_APP_URL to the deployed origin (e.g. https://venloop.example.com).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Supabase (`pnpm db:start`) prints these values under "API URLs" / "keys".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Speech: mock/browser = no server calls. verbx = real STT/TTS via VerbX (server-side key).
SPEECH_PROVIDER=mock
# auto = Groq, then VerbX, then browser live recognition. groq/verbx force one batch provider.
# groq uses GROQ_API_KEY below; whisper-large-v3 is more accurate, -turbo is faster.
SPEECH_STT_PROVIDER=auto
GROQ_STT_MODEL=whisper-large-v3-turbo
VERBX_API_KEY=
VERBX_BASE_URL=https://api.verbxeco.com
# Use GET /v1/tts/voices with X-API-Key; ids are verbx-female / verbx-male.
VERBX_TTS_VOICE_ID=verbx-female
TELEPHONY_PROVIDER=mock
NOTIFICATION_PROVIDER=mock

# Optional: natural-language wording for the simulated check-in call.
# Leave GROQ_API_KEY empty to use the deterministic scripted replies.
# Free-tier Groq key: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

DEMO_MODE=true
ENABLE_REAL_TELEPHONY=false
ENABLE_REAL_NOTIFICATIONS=false
ENABLE_DEMO_RESET=true
